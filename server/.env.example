# 复制为 server/.env 后按需填写

# 数据库（与 README 一致）
DB_HOST=localhost
DB_PORT=3306
DB_USER=studyapp
DB_PASSWORD=
DB_NAME=study_test

# 生产环境必填，长度 ≥16（建议 ≥32）；开发环境可不设（将使用占位密钥，切勿用于生产）
JWT_SECRET=

# 生产环境建议设置 NODE_ENV=production（将强制校验 JWT_SECRET）
# NODE_ENV=production

# 反向代理后限流需要真实客户端 IP 时设为 1
# TRUST_PROXY=1

# 服务端 Gemini 代理（POST /api/ai/gemini/generate），用户未在网页填写 Key 时文本类 AI 可走此密钥
GEMINI_API_KEY=

# 百度 OCR（可选）
# BAIDU_API_KEY=
# BAIDU_SECRET_KEY=

PORT=3100

# 邮箱验证码（服务端通过 EmailJS REST 发送；生产环境必填，缺失时注册/重置密码返回 502/503）
# 开发环境不配置时验证码校验自动跳过（可输入任意 6 位数字）
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=

# 允许跨域的来源（逗号分隔）；为空则仅允许同源。示例：http://localhost:3000,http://localhost:5173
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# M2 角色权威源：legacy(纯旧 users.role) | shadow(双读对账,默认) | org(以 org_members.role 为准)
# 翻 org 前必须：node scripts/reconcile-role-authority.cjs 输出「漂移=0」
# 回滚：改回 legacy/shadow 后 pm2 restart --update-env，即时生效，无需改代码
ROLE_AUTHORITY_SOURCE=shadow

# M3 org 读隔离：off(线上现状,默认) | shadow(旁路比对只打日志,不改结果) | enforce(按 org 强过滤,本阶段未启用)
# 代码默认 off（环境变量缺失即 off，安全）；翻 enforce 前必须：reconcile-org-isolation.cjs 分组完整 且 各 list 路由 [org-isolation:shadow] drift=0
ORG_ISOLATION_MODE=off
